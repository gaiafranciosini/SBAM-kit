int ParticleLoop(EVENTO_STRUCT *pevstr,ANA_STRUCT *panastr){
  int status = 0;
  int Nump = 0;
  Double_t secEkin=0.;
  int parent =0;
  Double_t secMomentum=0.;
  Nump = pevstr->nump;
  index_of_event++;
  Int_t parent_jpa = 0;
  Int_t secondary_jpa=0;

   parent=pevstr->idpa[0];
   parent_jpa=pevstr->jpa[0];
   
  
   for (int sec = 0; sec<Nump; sec++){
     secondary_jpa=pevstr->jpa[sec];
     secMomentum = sqrt(pevstr->px[sec]*pevstr->px[sec] + pevstr->py[sec]*pevstr->py[sec] +pevstr->pz[sec]*pevstr->pz[sec]);
     secEkin = sqrt( pevstr->amass[sec]*pevstr->amass[sec] + secMomentum*secMomentum) - pevstr->amass[sec];
   }
  

  return status;
}



