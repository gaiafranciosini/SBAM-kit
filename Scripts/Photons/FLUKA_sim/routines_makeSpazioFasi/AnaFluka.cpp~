  for( int ii = 0;ii<MAXBPLUS;ii++){
    panastr->vxi[ii] = 0.;
    panastr->vyi[ii] = 0.;
    panastr->vzi[ii] = 0.;
    panastr->tprod[ii] = 0.;
    panastr->tdec[ii] = 0.;
    panastr->pxplus[ii] = 0.;
    panastr->pyplus[ii] = 0.;
    panastr->pzplus[ii] = 0.;
    panastr->pxminus[ii] = 0.;
    panastr->pyminus[ii] = 0.;
    panastr->pzminus[ii] = 0.;

  }

  return 0;
}

