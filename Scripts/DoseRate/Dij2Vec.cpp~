  int vox_an, vox_an2;
  char comment[10] = "#";
  char flName[500];
  sprintf(flName,"%s",optfile.data());

  cout<<" Reading fluences from :: "<<flName<<endl;  

  ifstream tsC(flName);

  vector< vector <float> > field_fluences;
  vector< float > tmpfluence;
  int tmpfield (1);
  tmpfluence.clear();
