int main(int argc, char *argv[]){


  string configname("conf.txt");
  //Read input flags
  int lastA(0);
  bool isAngelica = kFALSE;
  bool doDRstudy(kFALSE);
  for(int i=0;i<argc;i++){
    args.push_back(argv[i]);
    
    if(strcmp(argv[i],"-con") == 0) { configname =TString(argv[++i]);    lastA--;  } //configfile name

    if(strcmp(argv[i],"-ange") == 0) { isAngelica = kTRUE;  } //angelica style

    if(strcmp(argv[i],"-doDR") == 0) { doDRstudy = kTRUE;  } //do the dose rate

    lastA = i;
  }

  if(argc == 2) lastA = 1;

  //Welcome banner
  banner();

  //  vector<string> lines = readLines("configfile.txt");
  cout<<"Reading config file " <<configname<<endl;
  vector<string> lines = readLines(configname);
  for(auto & l : lines) cout<<l<<endl;
  
  int idbflg, nfields, ierr;
  float VoxThres = 1.e-12;
  float Nfractions = 4.;
  int f_OARs = 0;
  cout<<"Parsing setup: directives:"<<endl;
  for(auto & l : lines){
    if(l.rfind("stpFlag:")==0){
      vector<string> tok=strtokens(l.substr(8));
      
      if((ierr=getIntParamRequired(tok,"debug",idbflg))) throw ierr;
      if(idbflg<0 || idbflg>2) throw 10;
      
      if((ierr=getIntParamRequired(tok,"nfields",nfields))) throw ierr;
      if(nfields<0 || nfields>7) throw 20;
      
      if((ierr=getFloatParam(tok,"dvoxthresh",VoxThres,1.e-12))) throw ierr;
      if(VoxThres==0) throw 30;
      
      if((ierr=getFloatParam(tok,"nfrac",Nfractions,4.))) throw ierr;
      if(Nfractions<=0) throw 40;

      if((ierr=getIntParam(tok,"OARsonly",f_OARs,0))) throw ierr;
      if(f_OARs!=0 && f_OARs != 1) throw 50;
    }
  }
  cout<<"----------------------------------------------------------------------"<<endl;


  cout<<"----------------------------------------------------------------------"<<endl;

  cout<<"Parsing input: directives:"<<endl;
  string fpath;
  for(auto & l : lines){
    if(l.rfind("ptvFile:")==0){
      vector<string> tok=strtokens(l.substr(8));
      fpath = tok[0].substr(0,tok[0].size());
    }
  }
  cout<<" The PTV is taken from: "<<fpath.data()<<endl;
  
  string optfile;
  for(auto & l : lines){
    if(l.rfind("optFile:")==0){
      vector<string> tok=strtokens(l.substr(8));
      optfile = tok[0].substr(0,tok[0].size());
    }
  }
  cout<<" The optimised fluences are taken from: "<<optfile.data()<<endl;

  string dijpath;
  for(auto & l : lines){
    if(l.rfind("dijFile:")==0){
      vector<string> tok=strtokens(l.substr(8));
      dijpath = tok[0].substr(0,tok[0].size());
    }
  }
  cout<<" The Dijs are taken from: "<<dijpath.data()<<endl;

  string outFlag = "test";
  for(auto & l : lines){
    if(l.rfind("outFlag:")==0){
      vector<string> tok=strtokens(l.substr(8));
      outFlag = tok[0].substr(0,tok[0].size());
    }
  }


  cout<<"Parsing Dose Rate: directives:"<<endl;
  float fmfMin, fmfThres, drThres, pulsetime; 
  for(auto & l : lines){
    if(l.rfind("drStudy:")==0){
      vector<string> tok=strtokens(l.substr(8));

      if((ierr=getFloatParamRequired(tok,"fmfMin",fmfMin))) throw ierr;
      if(fmfMin<0 || fmfMin>2) throw 10;
      
      if((ierr=getFloatParamRequired(tok,"fmfThres",fmfThres))) throw ierr;
      if(fmfThres<0) throw 20;
      
      if((ierr=getFloatParamRequired(tok,"drThres",drThres))) throw ierr;
      if(drThres==0) throw 30;

      if((ierr=getFloatParamRequired(tok,"pulsetime",pulsetime))) throw ierr;
      if(pulsetime==0) throw 30;

      if((ierr=getFloatParamRequired(tok,"prf",prf))) throw ierr;
