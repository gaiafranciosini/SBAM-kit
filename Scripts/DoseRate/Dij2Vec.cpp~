  mapA_dmf_drate_dtot.assign(mapA.size(), 0.0);

  for(int i_fi = 0; i_fi<nfields; i_fi++){
    mapA_drate[i_fi].assign(mapA.size(), 0.0);
    mapA_dose_threshold[i_fi].assign(mapA.size(), 0.0);
    mapA_dose_dmf_drate[i_fi].assign(mapA.size(), 0.0);
  }
  
  mapA_time.assign(mapA.size(), 0.0);

