      sscanf(buffertC, "%d\t%d\t%d\t%f",&f_totpbidx,&f_field,&f_fpbidx,&fluence);
    } else {
      sscanf(buffertC, "%d\t%d\t%f\t%d\t%d",&f_field,&f_fpbidx,&fluence,&vox_an,&vox_an2);
    }
    if(isAngelica) {
      //Angelica counts the fields from 0 and gives the fluences in units of 1e8
      fluence*= 1e8;
      f_field += 1;
    }

    if(Debug == 2) cout<<"Fluences vectors: field, tmp field, size: "<<f_field<<" "<<tmpfield<<" "<<tmpfluence.size()<<endl;
    
    if(f_field != tmpfield) {
      if(tmpfield != -1) field_fluences.push_back(tmpfluence);
      tmpfluence.clear();
      tmpfield = f_field;
    }
    if(f_field>0 && f_field<8)
      tmpfluence.push_back(fluence*Dose_Per_Fraction_scale);
    //    if(Debug == 2)
      cout<<"Fluence read: "<<f_fpbidx<<" "<<fluence<<" "<<Dose_Per_Fraction_scale<<endl;
  }//close while

  if(tmpfield != -1) field_fluences.push_back(tmpfluence);
  for(int it=0; it<(int)field_fluences.size(); it++) {
    cout<<"Read HMF::  "<<field_fluences.at(it).size()<<" for field "<<it+1<<endl;
    pbperfield.at(it) = field_fluences.at(it).size();
  }


  //We loop on the number of pre-defined matrixes.
  char DijName[200];
  int i_fi(1);

  //Initialize the Dij read params
  int nn[3];  float hs[3];  float x0[3];   int npb;
  float L[3];
  float front[3]={0,0,1};
  float up[3]   ={0,1,0};
  float left[3] ={1,0,0};
  int jpb,ifield,ni;

  //Load the PTV mask
  //myOpti.loadPTV_mhd(name,tok[0],plannedDose,weight/100.,DMF);
  //  loadROI_mhd(ptv,fpath);

  /*vector<float32> fmap_ptv;

  string dtype;
  size_t pos;
  string dataFile;
  read_mhd_header(fpath,dtype,nn,x0,L,left,up,front,dataFile,pos);
  cout<<"sono qui"<<endl;
  fmap_ptv.resize(1UL*nn[0]*nn[1]*nn[2]);
  cout<<"sono qui"<<endl;
  if(dtype=="MET_SHORT"){
    vector<int16> map;
    read_mhd(fpath,map,nn,x0,L,left,up,front);
    for(size_t i=0;i<fmap_ptv.size();i++) fmap_ptv[i]=map[i];
  } else if(dtype=="MET_INT"){
    vector<int32> map;
    read_mhd(fpath,map,nn,x0,L,left,up,front);
      for(size_t i=0;i<fmap_ptv.size();i++) fmap_ptv[i]=map[i];
  } else if(dtype=="MET_FLOAT"){
    read_mhd(fpath,fmap_ptv,nn,x0,L,left,up,front);
  } else {
    cerr<<"Error: data type "<<dtype<<" for "<<fpath<<" not yet supported"<<endl;
    exit(1);
  } 
  */
  // for(size_t i=0;i<ROI.size();i++) ROInew[i] = ROI[i]>0? 0 : 1;
  // write_mhd("aaa.mhd",ROInew,nn,x0,L,l,u,f);    

  int N;
  vector<int> Vi;   vector<float>di;

  map< int,vector<float> > DoseMap;
  map< int,vector<int> > PenbMap;
  std::map<int, vector<float> >::iterator itD;
  
  vector<float> tmpVecD;
  vector<int> tmpVecP;
  float t_flue;
  //Define root histograms
  //  TH1D *h_Pb = new TH1D("h_Pb","PB dist",100,0,100);
  //  TH1D *h_Dose = new TH1D("h_Dose","Dose dist",100,0,1.e-10);
  TH1D *h_Pb = new TH1D("h_Pb","PB dist",500,0,1500);
  TH1D *h_Dose = new TH1D("h_Dose","Dose dist",1000,0,10.);
  TH1D *h_DoseRate = new TH1D("h_DoseRate","Dose rate dist",10000,0,1.e7);

  TH1D *h_PbOne = new TH1D("h_PbOne","PB dist if 1 PB 1 field",100,0,100);
  TH1D *h_DoseOne = new TH1D("h_DoseOne","Dose dist if 1 PB 1 field",1000,0,1.e-10);
  TH1D *h_TimeOne = new TH1D("h_TimeOne","Time dist if 1 PB 1 field",1000,0,1.e-5);

  TH1D *h_Field = new TH1D("h_Field","Fields contributing to doserate map ",10,0,10);

  //  vector<vector<float> > Dose (npb, vector<float>(N, 0.));
  //loop on the sotred spots
  int FieldUS;
  vector<float> mapA;
  vector<float> mapField;    
  vector<float> mapA_dmf;    
  vector<float> mapA_dmf_drate;    
  vector<float> mapA_dmf_drate_dtot;   
