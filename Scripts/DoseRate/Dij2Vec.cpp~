	    dose_field_dtot.at(tmpF).push_back(t_dose);
	    dose_threshold.at(tmpF).push_back(t_dose);
	    timePB = getTime(tmpF,t_pbid-tmpF*1000);
	    dose_rate_field.at(tmpF).push_back(timePB);	    
	  }//close loop on mypbs size

