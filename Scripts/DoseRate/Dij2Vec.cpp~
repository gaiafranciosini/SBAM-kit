  vector<float> mapA_dose_threshold[nfields];   
  vector<float> mapA_dose_dmf_drate[nfields];   
  vector<float> mapA_time;

  float dmax_vxl = -1.;

  for(i_fi = 1; i_fi<nfields+1; i_fi++) {

    Vi.clear(); di.clear();
    tmpVecD.clear(); tmpVecP.clear();
    
    sprintf(DijName,"%s/E%d/field%d/out/Dijaaaa.bin",dijpath.data(),fieldEnergies[i_fi-1],i_fi);
    ifstream fin(DijName,ios::in|ios::binary);
    if(!fin){cerr<<"Error: cannot open "<<DijName<<" in "<<dijpath.data()<<" for input"<<endl;exit(1);}
    else {cout<<" Opening "<<DijName<<endl;}
    

    //Read the first line of Dij
    fin.read((char *)nn,3*sizeof(int));
    fin.read((char *)hs,3*sizeof(float));
    fin.read((char *)x0,3*sizeof(float));
    fin.read((char *)&npb,1*sizeof(int));

    for(int i=0;i<3;i++) {
      L[i]=hs[i]*nn[i];
      L[i]*=10;
      x0[i]*=10;
    }
    
    N = nn[0]*nn[1]*nn[2];
    mapField.assign(N, 0.0);
    cout<<"Num of spots: "<<npb<<endl;
    if(i_fi == 1) {
      mapA.assign(N, 0.0);
    }
    
    for(int j=0;j<npb;j++){
      
      cout<<"Scanning the PB n:: "<<j<<endl;
      
      // read which PB, which field, how many voxels 
      fin.read((char *)&jpb,sizeof(int));
      if(!fin){cerr<<"IO Error at line __LINE__"<<endl;exit(1);}
      fin.read((char *)&ifield,sizeof(int));
      if(!fin){cerr<<"IO Error at line __LINE__"<<endl;exit(1);}
      fin.read((char *)&ni,sizeof(int));
      if(!fin){cerr<<"IO Error at line __LINE__"<<endl;exit(1);}
      
      //reads voxels and di
      Vi.resize(ni);
      di.resize(ni);
      if(Debug ==2) cout<<"PB, Field, n voxels: \t"<<jpb<<' '<<ifield<<" : "<<ni<<endl;
      
      if(!j) FieldUS = ifield;
      
      if(ni>0){
	fin.read((char *)Vi.data(),ni*sizeof(int)  );
	if(!fin){cerr<<"IO Error at line __LINE__"<<endl;exit(1);}
	fin.read((char *)di.data(),ni*sizeof(float));
	if(!fin){cerr<<"IO Error at line __LINE__"<<endl;exit(1);}
      }

      tmpfluence = field_fluences.at(FieldUS-1);

      if(Debug ==2)
	cout<<"flue "<<FieldUS<<" "<<jpb<<" "<<tmpfluence.size()<<endl;

      if(jpb < (int)tmpfluence.size()) {
	if(Debug ==2) cout<<"Field under study:  "<<FieldUS<<" PB: "<<jpb<<" fluence: "<<tmpfluence.at(jpb)<<endl;
	t_flue = tmpfluence.at(jpb);
      } else{
	cout<<" ERROR:: Asking for PB:: "<<jpb<<" but we have stored only "<<tmpfluence.size()<<" values "<<endl;
	t_flue = 0;
      }
      cout<<" NI "<<ni<<endl;
      //Define the maps, per voxel, of PB giving contributions and relative dose.
      for(size_t i=0;i<ni;i++){

	if(di[i]>dmax_vxl){
	  dmax_vxl = di[i];
	}
	mapA.at(Vi[i]) += t_flue*di[i]; // fill with dose, scaling with optimised fluence: sum for each pb and field!
	mapField.at(Vi[i])+=t_flue*di[i]; // fill with dose, scaling with optimised fluence: sum for each pb!!
	
	if(doDRstudy) {
	  itD = DoseMap.find(Vi[i]);
	  
	  //Fill the maps only if the dose is over threshold
	  if(di[i]>threshold) {

	    //	    cout<<di[i]<<" "<<threshold<<" "<<t_flue<<endl;
	    //	    mapA.at(Vi[i]) += t_flue*di[i]; // fill with dose, scaling with optimised fluence: sum for each pb and field!
	    
	    if(itD == DoseMap.end()) {
	      
	      if(Debug==2)  cout<<" First Time I see that voxel:: "<<i<<" "<<Vi[i]<<" "<<di[i]<<endl;
	      
	      //Stores the dose per voxel
	      tmpVecD.clear();
	      tmpVecD.push_back(t_flue*di[i]);
	      //Stores the pb that is contributing
	      tmpVecP.clear();
	      tmpVecP.push_back(j+1000*(FieldUS-1));
	      //Fills the maps
	      DoseMap.insert(pair<int, vector<float> > (Vi[i],tmpVecD) );
	      PenbMap.insert(pair<int, vector<int> > (Vi[i],tmpVecP) );
	      
	    } else {
	      if(Debug==2) 	  cout<<" Voxel already seen:: "<<i<<" "<<Vi[i]<<" "<<t_flue*di[i]<<endl;
	      tmpVecD = DoseMap.find(Vi[i])->second;
	      tmpVecP = PenbMap.find(Vi[i])->second;
	      if(Debug==2) 	  cout<<" Vec sizes before "<<tmpVecD.size()<<" "<<tmpVecP.size()<<endl;
	      tmpVecD.push_back(t_flue*di[i]);
	      DoseMap[ Vi[i] ] = tmpVecD;
	      tmpVecP.push_back(j+1000*(FieldUS-1));
	      PenbMap[ Vi[i] ] = tmpVecP;
	    }
	  }else{
	    tmpVecD.push_back(0.);

	  }//close di > threshold
	}
	
	Vi.clear();
	di.clear();
      }//close loop on n vxl
      string Dosename_1 = outFlag + "DoseWithFluences"+std::to_string(i_fi)+".mhd";
      write_mhd(Dosename_1,mapField,nn,x0,L,left,up,front);
      //mapField.clear();
    }//close loop on npb

    
  }//close loop on nfields

  cout<<"On all VXLs, PBs and FIELDs: dmax vxl = "<<dmax_vxl<<endl;

  string Dosename = outFlag + "DoseWithFluences.mhd";
  write_mhd(Dosename,mapA,nn,x0,L,left,up,front);

  mapA_dmf.assign(mapA.size(), 0.0);
  
  //Apply a DMF 
  float t_dose; float fmf=1; float fmf_dtot;
  float fmf_min = fmfMin; float d_threshold = fmfThres;
  for(int it = 0; it<(int)mapA_dmf.size(); it++) {
    t_dose = mapA.at(it);//t_dose here is already the total dose per vxl from the sum of each pb and field!
    // if(t_dose>d_threshold  && (fmap_ptv.at(it) == 0 || f_OARs)) {
     if(t_dose>d_threshold) {
      fmf = (1-fmf_min)*(d_threshold/t_dose) + fmf_min;
    } else {
      fmf = 1;
    }
    //    mapA_dmf.at(it) += t_dose*fmf; // fill with dose, scaling with optimised fluence
    mapA_dmf.at(it) = t_dose*fmf; // fill with dose, scaling with optimised fluence
  }

  //map with total dose per vxl from each pb and field, scaled by FMF if TOT dose per VXL > d_thr
  Dosename = outFlag + "DoseWithFluences_DMF.mhd";
  write_mhd(Dosename,mapA_dmf,nn,x0,L,left,up,front);

  TFile *myF = new TFile(Form("myOutHistos_%s.root",outFlag.c_str()),"RECREATE");
