  float f_dose, f_time;
  fdTree->Branch("dose", &f_dose, "dose/F");
  fdTree->Branch("time", &f_time, "time/F");
  
  int t_pbid(0), tmpF(-1);
  float inst_time, t_doseTot, t_dose_rate_inst;
  char hn[300]; TH1D* h;
  vector < vector <float> > dose_field;
  vector < vector <float> > dose_rate_field;

  float dose_rate_threshold(drThres), timePB;
  vector< float > d_field;
  vector< float > d_r_field;


  int numvxl_adr = 0;
  int numvxl_dosetot = 0;
  float t_dose_dmf = 0;
  float t_dose_thr = 0;
  float t_dose_dtot = 0;
  vector < vector <float> > dose_field_dmf;
  vector < vector <float> > dose_field_dtot;
  vector < vector <float> > dose_threshold;

  if(doDRstudy) {
    /*
    //Fast loop on all the dose
    for ( const auto &pD : DoseMap )
      {
